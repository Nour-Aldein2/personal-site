---
import { sitePath } from "../lib/site";
interface Props { items: {label:string; href?:string}[]; }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="breadcrumbs"><ol>
{items.map(item => <li>{item.href ? <a href={item.href.startsWith("/") ? sitePath(item.href) : item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}
</ol></nav>
