---
import type { MarkdownHeading } from "astro";
import ArticleTocList from "./ArticleTocList.astro";
import { buildToc } from "../lib/toc";

interface Props {
  headings: MarkdownHeading[];
}

const items = buildToc(Astro.props.headings);
---

{items.length > 0 && (
  <aside class="content-card article-toc" aria-label="On this page">
    <p class="article-toc__title">On this page</p>
    <ArticleTocList items={items} />
  </aside>
)}