---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortArticles } from "../lib/articles";
import { featuredProjects } from "../lib/projects";
import { absoluteSiteUrl, sitePath, siteSettings } from "../lib/site";

const articles = sortArticles(
  await getCollection("articles", ({ data }) => !data.draft),
);
const featuredArticles = articles.filter((entry) => entry.data.featured).slice(0, 3);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteSettings.authorName,
  alternateName: siteSettings.alternateNames,
  jobTitle: siteSettings.authorRole,
  description: siteSettings.siteDescription,
  image: absoluteSiteUrl(siteSettings.authorImage, Astro.site),
  url: absoluteSiteUrl("/", Astro.site),
  sameAs: siteSettings.sameAs,
  knowsAbout: [
    "Artificial intelligence",
    "Machine learning",
    "Natural language processing",
    "Model explainability",
    "Technical writing",
    "Astrophysics",
  ],
  homeLocation: {
    "@type": "Place",
    name: siteSettings.location,
  },
};
---
<BaseLayout
  title={`${siteSettings.authorName} | AI Engineer/Researcher`}
  description={siteSettings.siteDescription}
  canonicalPath="/"
  ogType="profile"
  image={siteSettings.authorImage}
  schema={personSchema}
>
  <div class="shell">
    <section class="hero hero--borderless">
      <div class="hero-card">
        <p class="eyebrow">Portfolio</p>
        <h1>{siteSettings.authorName}</h1>
        <p>
          I am an AI/ML engineer and researcher with an MSc in AI (Distinction)
          from the University of Bath and over four years of experience across academia and industry.
          I am specialising in reinforcement learning, computer vision, and statistical modelling,
          applying them to projects like generative modelling for stroke-ordered drawing and
          chemical recipe optimisation (e.g. for MXene).
        </p>
        <p>
          My broader technical interests span MLOps, control and optimisation, reinforcement learning,
          quantitative analysis, natural language processing, computer vision, and computer graphics.
          This site showcases some examples of my end-to-end ML work and research, demonstrating
          my skills and interests across the diverse fields I am working on.
        </p>
      </div>
      <aside class="profile-panel">
        <img
          src={sitePath(siteSettings.authorImage)}
          alt={siteSettings.authorName}
          width="580"
          height="696"
          fetchpriority="high"
          decoding="async"
        />
        <div class="profile-panel__meta">
          <p class="eyebrow">Profiles</p>
          <div class="profile-links">
            <a
              class="profile-link profile-link--icon"
              href={siteSettings.sameAs[0]}
              rel="me noopener noreferrer"
              target="_blank"
              aria-label="GitHub"
            >
              <Icon name="github" />
              <span class="sr-only">GitHub</span>
            </a>
            <a
              class="profile-link profile-link--icon"
              href={siteSettings.sameAs[1]}
              rel="me noopener noreferrer"
              target="_blank"
              aria-label="LinkedIn"
            >
              <Icon name="linkedin" />
              <span class="sr-only">LinkedIn</span>
            </a>
            <a
              class="profile-link profile-link--icon"
              href={siteSettings.contactHref}
              aria-label="Contact"
            >
              <Icon name="mail" />
              <span class="sr-only">Contact</span>
            </a>
          </div>
        </div>
      </aside>
    </section>
    <section class="page-section">
      <div class="section-heading section-heading--wide">
        <p class="eyebrow">Writing</p>
        <h2>Selected articles and case studies</h2>
      </div>
      <div class="article-index-grid">
        {featuredArticles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
    <section class="page-section">
      <div class="section-heading section-heading--wide">
        <p class="eyebrow">Projects</p>
        <h2>Selected machine learning and research projects</h2>
        <p>
          A compact view of applied machine learning, computer vision, and
          research-oriented work drawn from the broader portfolio.
        </p>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
/* BEGIN personal-site homepage design */
  /* Homepage-specific dimensions. Shared palette and header rules live in
     styles/theme.css and styles/header.css for every page. */
  .hero--borderless {
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 0.9fr);
  }

  .hero--borderless .hero-card,
  .hero--borderless .profile-panel {
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .hero--borderless .hero-card {
    color: var(--ink);
  }

  .hero--borderless .hero-card h1 {
    color: var(--ink);
    /* Exactly 4pt smaller than the original responsive name, at every width. */
    font-size: calc(clamp(2.2rem, 5vw, 4rem) - 4pt);
    line-height: 1.05;
  }

  .hero--borderless .hero-card p:not(.eyebrow) {
    color: var(--article-copy, var(--ink));
    line-height: 1.7;
  }

  .hero--borderless .hero-card p:last-child {
    margin-bottom: 0;
  }

  .hero--borderless .hero-card .eyebrow {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .hero--borderless .profile-panel {
    width: min(100%, 290px);
    justify-self: end;
  }

  .hero--borderless .profile-panel img {
    border-radius: 0;
  }

  /* Keep secondary links legible if the existing commented-out buttons
     are re-enabled later, now that the card backdrop is gone. */
  .hero--borderless .button-link--secondary {
    color: var(--accent-soft);
    border-color: var(--border);
    background: transparent;
  }

  @media (max-width: 900px) {
    .hero--borderless {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero--borderless .profile-panel {
      justify-self: start;
    }
  }
/* END personal-site homepage design */
</style>
