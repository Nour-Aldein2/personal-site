---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath, siteSettings } from "../../lib/site";
const cvHref = sitePath(siteSettings.cvFilePath);
---
<BaseLayout title={`${siteSettings.authorName} CV`} description={`Curriculum vitae of ${siteSettings.authorName}.`} canonicalPath={siteSettings.cvFilePath}>
  <Fragment slot="head"><meta http-equiv="refresh" content={`0;url=${cvHref}`} /></Fragment>
  <section class="shell legacy-redirect"><h1>Curriculum vitae</h1><p>Redirecting to the CV PDF.</p><p><a class="button-link button-link--primary" href={cvHref}>Open CV</a></p></section>
</BaseLayout>
