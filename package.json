{
  "name": "noor-aldeeen-personal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/restore-assets.mjs --check",
    "build": "astro build",
    "postbuild": "node scripts/finalize-build.mjs && node scripts/check-build.mjs",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "astro": "7.3.3",
    "katex": "0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  }
}
